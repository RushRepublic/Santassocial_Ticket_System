# Copy to backend/.env. Demo uses local SQLite and never charges real money.
APP_MODE=demo
# Payment provider is independent of simulated WhatsApp OTP/notifications.
# Keep demo until Live Razorpay credentials and the webhook secret are configured.
PAYMENT_MODE=demo
NODE_ENV=development
# Hosted test prototype only: NODE_ENV=production, APP_MODE=demo,
# ALLOW_HOSTED_DEMO=true, DB_DRIVER=mysql, DATABASE_URL and HTTPS origin,
# unique secrets and explicit admin credentials. Limited staff accounts are optional.
ALLOW_HOSTED_DEMO=false
# Local demo defaults to sqlite; hosted demo and live deployments require mysql.
# DB_DRIVER=mysql
MAINTENANCE_MODE=interval
PORT=4000
FRONTEND_ORIGIN=http://127.0.0.1:3000
DATABASE_URL=mysql://santa:CHANGE_ME@127.0.0.1:3306/santa_social
# Alternative to DATABASE_URL: set all required individual fields. These take
# precedence over DATABASE_URL and DB_PASSWORD must be the literal password.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
SESSION_SECRET=replace-with-at-least-32-random-characters
TICKET_SECRET=replace-with-a-different-32-character-random-secret
OTP_SECRET=replace-with-a-third-32-character-random-secret
# Real Razorpay with simulated OTP: APP_MODE=demo, PAYMENT_MODE=live.
# See docs/RAZORPAY-LIVE.md. Use Live keys only; keep all secrets server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Adapter requires a confirmed AskEva authentication/utility API specification.
ASKEVA_ADAPTER_MODULE=
ASKEVA_API_KEY=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
ADMIN_EMAIL=admin@santasocial.local
ADMIN_PASSWORD=
SCANNER_EMAIL=scanner@santasocial.local
SCANNER_PASSWORD=
CASHIER_EMAIL=cashier@santasocial.local
CASHIER_PASSWORD=
